// Trackpad magnify and rotate gestures, as exposed by WebKit.
[
    Conditional=MAC_GESTURE_EVENTS,
    Exposed=Window
] interface GestureEvent : UIEvent {
    readonly attribute unrestricted double screenX;
    readonly attribute unrestricted double screenY;
    readonly attribute unrestricted double clientX;
    readonly attribute unrestricted double clientY;
    readonly attribute boolean ctrlKey;
    readonly attribute boolean shiftKey;
    readonly attribute boolean altKey;
    readonly attribute boolean metaKey;
    readonly attribute double scale;
    readonly attribute double rotation;
    readonly attribute EventTarget? target;

    undefined initGestureEvent([AtomString] DOMString type, boolean bubbles, boolean cancelable, WindowProxy? view, long detail, unrestricted double screenX, unrestricted double screenY, unrestricted double clientX, unrestricted double clientY, boolean ctrlKey, boolean altKey, boolean shiftKey, boolean metaKey, double scale, double rotation, EventTarget? target);
};
