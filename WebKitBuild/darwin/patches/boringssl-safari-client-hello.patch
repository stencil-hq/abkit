 void SSL_CTX_set_grease_sigalgs_enabled(SSL_CTX *ctx, int enabled) {
   FromOpaque(ctx)->grease_sigalgs_enabled = !!enabled;
+}
+
+int SSL_CTX_set_tls13_cipher_order(SSL_CTX *ctx, const uint16_t *ciphers,
+                                   size_t num_ciphers) {
+  SSLContext *ctx_impl = FromOpaque(ctx);
+  if (num_ciphers != std::size(ctx_impl->tls13_cipher_order)) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+    return 0;
+  }
+  for (size_t i = 0; i < num_ciphers; i++) {
+    const SSL_CIPHER *cipher = SSL_get_cipher_by_value(ciphers[i]);
+    if (cipher == nullptr ||
+        SSL_CIPHER_get_min_version(cipher) != TLS1_3_VERSION ||
+        std::find(ciphers, ciphers + i, ciphers[i]) != ciphers + i) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+      return 0;
+    }
+  }
+  std::copy(ciphers, ciphers + num_ciphers, ctx_impl->tls13_cipher_order);
+  ctx_impl->tls13_cipher_order_configured = true;
+  return 1;
 }
 
