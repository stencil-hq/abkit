+#if defined(__APPLE__) && defined(OPENSSL_IS_BORINGSSL)
+/* The Security framework may wait for the trust daemon to fetch an
+ * intermediate or a revocation status, and it wants what the peer stapled to
+ * the handshake. Both call for evaluating here, on the handshake thread, and
+ * handing the result to verify_chain(), which runs on the thread that owns the
+ * connection.
+ */
+static void
+handshake_thread_evaluate_system_trust (GTlsConnectionOpenssl *openssl)
+{
+  GTlsConnectionBase *tls = G_TLS_CONNECTION_BASE (openssl);
+  GTlsConnectionOpensslPrivate *priv;
+  GSocketConnectable *identity = NULL;
+  GTlsCertificate *chain;
+  const uint8_t *ocsp_response, *sct_list;
+  size_t ocsp_response_length, sct_list_length;
+  gboolean is_client;
+  SSL *ssl;
+
+  priv = g_tls_connection_openssl_get_instance_private (openssl);
+  priv->system_trust_evaluated = FALSE;
+
+  if (!G_IS_TLS_DATABASE_SEC_TRUST (g_tls_connection_get_database (G_TLS_CONNECTION (tls))))
+    return;
+
+  chain = g_tls_connection_openssl_retrieve_peer_certificate (tls);
+  if (!chain)
+    return;
+
+  is_client = G_IS_TLS_CLIENT_CONNECTION (tls);
+  if (is_client)
+    {
+      if (!g_tls_connection_base_is_dtls (tls))
+        identity = g_tls_client_connection_get_server_identity (G_TLS_CLIENT_CONNECTION (tls));
+      else
+        identity = g_dtls_client_connection_get_server_identity (G_DTLS_CLIENT_CONNECTION (tls));
+    }
+
+  ssl = g_tls_connection_openssl_get_ssl (openssl);
+  SSL_get0_ocsp_response (ssl, &ocsp_response, &ocsp_response_length);
+  SSL_get0_signed_cert_timestamp_list (ssl, &sct_list, &sct_list_length);
+
+  priv->system_trust_errors = g_tls_database_sec_trust_evaluate (chain,
+                                                                 is_client ? G_TLS_DATABASE_PURPOSE_AUTHENTICATE_SERVER : G_TLS_DATABASE_PURPOSE_AUTHENTICATE_CLIENT,
+                                                                 identity,
+                                                                 ocsp_response, ocsp_response_length,
+                                                                 sct_list, sct_list_length);
+  priv->system_trust_evaluated = TRUE;
+
+  g_object_unref (chain);
+}
+#endif
