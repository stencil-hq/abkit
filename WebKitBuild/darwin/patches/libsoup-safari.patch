diff --git a/libsoup/soup-safari-request-headers.c b/libsoup/soup-safari-request-headers.c
--- a/libsoup/soup-safari-request-headers.c
+++ b/libsoup/soup-safari-request-headers.c
@@ -0,0 +1,328 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 8 -*- */
+/*
+ * Copyright (C) 2026 Stencil
+ *
+ * Redistribution and use in source and binary forms, with or without
