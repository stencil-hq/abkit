+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/* The request headers of a message as Safari puts them on the wire. This is
+ * the one place that decides their order, for HTTP/1.1 and for HTTP/2.
+ *
+ * Safari's order is not a list of names. WebKit hands its headers to CFNetwork,
+ * which keeps them in a hash table and writes them in the table's order, so the
+ * order depends on which headers there are and on the order they were set in.
+ * CFNetwork then writes the headers it adds itself. What Safari sends is:
+ *
+ *   Host (HTTP/1.1)
+ *   the application's headers, with Content-Length when there is a body, in
+ *     the order of CFNetwork's table
+ *   Content-Length: 0 for a request without a body whose method usually has one
+ *   Accept when the application set none
+ *   Accept-Language, Priority, Accept-Encoding, Cookie, unless the application
+ *     set them, which puts them in the table
+ *   Sec-WebSocket-Key, Connection, Upgrade (a WebSocket handshake), or
+ *     Connection: keep-alive (HTTP/1.1)
+ *
+ * The table's order is CFNetwork's to know, so it is asked for it: the names go
+ * into a CFHTTPMessage in the order they were appended here, and the message
+ * says how it would write them. That also gives the spelling Safari uses for
+ * the names over HTTP/1.1.
+ *
+ * One more thing shapes the table. WebKit's web process fills it and, for a
+ * request with a body, sends it to the network process as it is. When the
+ * network process then changes the request (the access control checks of a
+ * cross-origin fetch do, and so does trimming the referrer of a third-party
+ * request), WebKit empties the table and fills it again in the order of the
+ * dictionary CFNetwork returns for all header fields, which moves headers whose
+ * slots collide. The application says so by setting
+ * SOUP_MESSAGE_SAFARI_HEADER_TABLE_REFILLED on the message.
+ */
+
+#include "config.h"
+
+#include "soup-safari-request-headers.h"
+
+#include <CFNetwork/CFNetwork.h>
+#include <string.h>
+
+#include "soup.h"
+#include "soup-message-headers-private.h"
+#include "soup-misc.h"
+
+typedef struct {
+        char *name;
+        char *value;
+} Header;
+
+static void
+header_clear (Header *header)
+{
+        g_free (header->name);
+        g_free (header->value);
+}
+
+static Header *
+find_header (GArray     *headers,
+             const char *name)
+{
+        for (guint i = 0; i < headers->len; i++) {
+                Header *header = &g_array_index (headers, Header, i);
+
+                if (!g_ascii_strcasecmp (header->name, name))
+                        return header;
+        }
+        return NULL;
+}
+
+/* Headers CFNetwork writes at a place of its own rather than from its table. */
+static gboolean
+has_fixed_place (SoupMessageHeaders *request_headers,
+                 const char         *name,
+                 const char         *value)
+{
+        static const char *const names[] = {
+                "Host", "Cookie", "Connection", "Upgrade", "Sec-WebSocket-Key"
+        };
+
+        for (guint i = 0; i < G_N_ELEMENTS (names); i++) {
+                if (!g_ascii_strcasecmp (name, names[i]))
+                        return TRUE;
+        }
+
+        /* The library's own Accept-Language and Accept-Encoding stand for the
+         * ones CFNetwork adds; the application's are in the table.
+         */
+        if (!g_ascii_strcasecmp (name, "Accept-Language"))
+                return soup_message_headers_is_automatic (request_headers, SOUP_HEADER_ACCEPT_LANGUAGE);
+        if (!g_ascii_strcasecmp (name, "Accept-Encoding"))
+                return soup_message_headers_is_automatic (request_headers, SOUP_HEADER_ACCEPT_ENCODING);
+
+        /* A length of zero is not in the table: CFNetwork writes it when it
+         * finds no body.
+         */
+        return !g_ascii_strcasecmp (name, "Content-Length") && !strcmp (value, "0");
+}
+
+static void
+set_header (CFHTTPMessageRef  message,
+            const char       *name,
+            gboolean          present)
+{
+        CFStringRef string = CFStringCreateWithCString (NULL, name, kCFStringEncodingASCII);
+
+        CFHTTPMessageSetHeaderFieldValue (message, string, present ? CFSTR ("-") : NULL);
+        CFRelease (string);
+}
+
+static void
+collect_name (const void *name,
+              const void *value,
+              void       *names)
+{
+        CFIndex size = CFStringGetMaximumSizeForEncoding (CFStringGetLength (name), kCFStringEncodingUTF8) + 1;
+        char *string = g_malloc (size);
+
+        if (CFStringGetCString (name, string, size, kCFStringEncodingUTF8))
+                g_ptr_array_add (names, string);
+        else
+                g_free (string);
+}
+
+/* The names of @headers in the order of CFNetwork's table, in its spelling. */
+static GPtrArray *
+table_order (GArray   *headers,
+             gboolean  refilled)
+{
+        GPtrArray *names = g_ptr_array_new_with_free_func (g_free);
+        CFURLRef url = CFURLCreateWithString (NULL, CFSTR ("http://localhost/"), NULL);
+        CFHTTPMessageRef message = CFHTTPMessageCreateRequest (NULL, CFSTR ("GET"), url, kCFHTTPVersion1_1);
+        CFDataRef serialized;
+
+        /* Content-Length joins the table last: WebKit sets it where the body is attached.
+         * Accept-Encoding is CFNetwork's own coding header, written after the application's
+         * headers, so an application-supplied one takes its place in the table last too.
+         */
+        for (guint i = 0; i < headers->len; i++) {
+                const char *name = g_array_index (headers, Header, i).name;
+
+                if (g_ascii_strcasecmp (name, "Accept-Encoding") && (!refilled || g_ascii_strcasecmp (name, "Content-Length")))
+                        set_header (message, name, TRUE);
+        }
+        if (find_header (headers, "Accept-Encoding"))
+                set_header (message, "Accept-Encoding", TRUE);
+
+        if (refilled) {
+                CFDictionaryRef fields = CFHTTPMessageCopyAllHeaderFields (message);
+                GPtrArray *order = g_ptr_array_new_with_free_func (g_free);
+
+                CFDictionaryApplyFunction (fields, collect_name, order);
+                for (guint i = 0; i < order->len; i++)
+                        set_header (message, order->pdata[i], FALSE);
+                for (guint i = 0; i < order->len; i++)
+                        set_header (message, order->pdata[i], TRUE);
+                if (find_header (headers, "Content-Length"))
+                        set_header (message, "Content-Length", TRUE);
+
+                g_ptr_array_unref (order);
+                CFRelease (fields);
+        }
+
+        serialized = CFHTTPMessageCopySerializedMessage (message);
+        if (serialized) {
+                char *text = g_strndup ((const char *)CFDataGetBytePtr (serialized), CFDataGetLength (serialized));
+                char **lines = g_strsplit (text, "\r\n", -1);
+
+                /* The first line is the request line. */
+                for (guint i = 1; lines[i] && *lines[i]; i++) {
+                        char *colon = strchr (lines[i], ':');
+
+                        if (colon)
+                                g_ptr_array_add (names, g_strndup (lines[i], colon - lines[i]));
+                }
+                g_strfreev (lines);
+                g_free (text);
+                CFRelease (serialized);
+        }
+
+        CFRelease (message);
+        CFRelease (url);
+        return names;
+}
+
+static const char *
+priority_value (SoupMessage *msg)
+{
+        /* The urgency CFNetwork derives from a load's priority; it marks every
+         * load incremental.
+         */
+        switch (soup_message_get_priority (msg)) {
+        case SOUP_MESSAGE_PRIORITY_VERY_HIGH:
+                return "u=0, i";
+        case SOUP_MESSAGE_PRIORITY_HIGH:
+                return "u=1, i";
+        case SOUP_MESSAGE_PRIORITY_NORMAL:
+                return "u=3, i";
+        case SOUP_MESSAGE_PRIORITY_LOW:
+                return "u=5, i";
+        case SOUP_MESSAGE_PRIORITY_VERY_LOW:
+                return "u=7, i";
+        }
+        return "u=3, i";
+}
+
+void
+soup_safari_request_headers_foreach (SoupMessage                 *msg,
+                                     SoupSafariRequestHeaderFunc  func,
+                                     gpointer                     user_data)
+{
+        SoupMessageHeaders *request_headers = soup_message_get_request_headers (msg);
+        gboolean http2 = soup_message_get_http_version (msg) == SOUP_HTTP_2_0;
+        const char *method = soup_message_get_method (msg);
+        GArray *table = g_array_new (FALSE, FALSE, sizeof (Header));
+        GArray *fixed = g_array_new (FALSE, FALSE, sizeof (Header));
+        SoupMessageHeadersIter iter;
+        const char *name, *value;
+        GPtrArray *names;
+        Header *header;
+        gboolean websocket;
+
+        g_array_set_clear_func (table, (GDestroyNotify)header_clear);
+        g_array_set_clear_func (fixed, (GDestroyNotify)header_clear);
+
+        soup_message_headers_iter_init (&iter, request_headers);
+        while (soup_message_headers_iter_next (&iter, &name, &value)) {
+                GArray *headers = has_fixed_place (request_headers, name, value) ? fixed : table;
+
+                header = find_header (headers, name);
+                if (header) {
+                        char *joined = g_strconcat (header->value, ", ", value, NULL);
+
+                        g_free (header->value);
+                        header->value = joined;
+                } else {
+                        Header new_header = { g_strdup (name), g_strdup (value) };
+
+                        g_array_append_val (headers, new_header);
+                }
+        }
+
+        header = find_header (fixed, "Host");
+        if (header && !http2)
+                func ("Host", header->value, user_data);
+
+        names = table_order (table, g_object_get_data (G_OBJECT (msg), SOUP_MESSAGE_SAFARI_HEADER_TABLE_REFILLED) != NULL);
+        for (guint i = 0; i < names->len; i++) {
+                header = find_header (table, names->pdata[i]);
+                if (header)
+                        func (names->pdata[i], header->value, user_data);
+        }
+        g_ptr_array_unref (names);
+
+        if (!find_header (table, "Content-Length") &&
+            method != SOUP_METHOD_GET && method != SOUP_METHOD_HEAD && method != SOUP_METHOD_CONNECT)
+                func ("Content-Length", "0", user_data);
+
+        if (!find_header (table, "Accept"))
+                func ("Accept", "*/*", user_data);
+
+        header = find_header (fixed, "Accept-Language");
+        if (header)
+                func ("Accept-Language", header->value, user_data);
+
+        if (!find_header (table, "Priority"))
+                func ("Priority", priority_value (msg), user_data);
+
+        header = find_header (fixed, "Accept-Encoding");
+        if (header)
+                func ("Accept-Encoding", header->value, user_data);
+
+        header = find_header (fixed, "Cookie");
+        if (header && http2) {
+                /* Over HTTP/2 Safari sends each cookie in a header of its own. */
+                char **cookies = g_strsplit (header->value, "; ", -1);
+
+                for (guint i = 0; cookies[i]; i++) {
+                        if (*cookies[i])
+                                func ("Cookie", cookies[i], user_data);
+                }
+                g_strfreev (cookies);
+        } else if (header)
+                func ("Cookie", header->value, user_data);
+
+        if (!http2) {
+                websocket = (header = find_header (fixed, "Upgrade")) != NULL;
+                if (websocket) {
+                        Header *key = find_header (fixed, "Sec-WebSocket-Key");
+
+                        if (key)
+                                func ("Sec-WebSocket-Key", key->value, user_data);
+                        func ("Connection", "Upgrade", user_data);
+                        func ("Upgrade", header->value, user_data);
+                } else {
+                        header = find_header (fixed, "Connection");
+                        func ("Connection", header && g_ascii_strcasecmp (header->value, "Keep-Alive") ? header->value : "keep-alive", user_data);
+                }
+        }
+
+        g_array_unref (table);
+        g_array_unref (fixed);
+}
